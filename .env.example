# Copy this file to `.env` and fill in at least one key.
#
# Cerebras has a free tier and serves several open-weight model families behind
# one key, which is enough to run the whole courtroom with genuine model
# diversity. Get one at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Optional. If present, these take over the roles they are better suited for
# (see ROSTER in veritas/config.py). Everything degrades gracefully.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# --- Tunables (all optional) ---
# VERITAS_MAX_TOKENS=1600
# VERITAS_JUDGE_MAX_TOKENS=2200
# VERITAS_TEMPERATURE=0.35
# VERITAS_TIMEOUT=90
# VERITAS_MAX_REPAIRS=2
