# Copy to `.env.local` for local dev. On Vercel, set these as Environment
# Variables in the project settings — they stay server-side and are never
# exposed to the browser (no NEXT_PUBLIC_ prefix, deliberately).
#
# You need at least one. Cerebras and Groq both have free tiers, and between
# them they serve every model in the roster.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Optional — picked up automatically if present.
OPENAI_API_KEY=

# --- Tunables (all optional) ---
# VERITAS_MAX_TOKENS=1600
# VERITAS_JUDGE_MAX_TOKENS=2200
# VERITAS_TEMPERATURE=0.35
# VERITAS_TIMEOUT_MS=90000
# VERITAS_MAX_REPAIRS=2
